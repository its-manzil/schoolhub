# SchoolHub Project - Single .gitignore File

# Environment files (keep examples, ignore actual files)
.env
.env.*
.env.local
.env.local*
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Dependencies
node_modules/
/node_modules/
frontend/node_modules/
server/node_modules/

# Package managers
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build artifacts
.next/
out/
build/
dist/
frontend/.next/
frontend/out/
frontend/build/
server/build/

# Testing
coverage/
frontend/coverage/
server/coverage/
.nyc_output/

# Logs
*.log
logs/
server.log
frontend/logs/
server/logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Temporary files
*.tmp
*.temp
temp/
uploads/

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
frontend/.vercel/

# Cache
.npm
.cache/
.parcel-cache/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Keep important files
!README.md
!DEPLOYMENT.md
!.gitignore
!frontend/
!server/
